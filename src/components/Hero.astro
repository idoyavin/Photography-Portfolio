---
import { HERO_SLIDES, SITE } from '../data/site';
import { photoUrl, photoSrcSet } from '../data/galleries';
---

<section class="hero" data-hero>
  <div class="hero__stage">
    {
      HERO_SLIDES.map((slide, index) => (
        <figure
          class:list={['hero__slide', { 'is-active': index === 0 }]}
          data-slide
          aria-hidden={index === 0 ? undefined : 'true'}
        >
          {/* Every slide sits in the viewport, so loading="lazy" would be
              ignored and all five would race the LCP image. Only the first
              gets a real src; the rest are attached after the page loads. */}
          <img
            src={index === 0 ? photoUrl(slide.gallery, slide.src, 1280) : undefined}
            srcset={index === 0 ? photoSrcSet(slide.gallery, slide.src) : undefined}
            data-src={index === 0 ? undefined : photoUrl(slide.gallery, slide.src, 1280)}
            data-srcset={index === 0 ? undefined : photoSrcSet(slide.gallery, slide.src)}
            sizes="100vw"
            alt={index === 0 ? slide.alt : ''}
            width="1280"
            height="1920"
            fetchpriority={index === 0 ? 'high' : 'low'}
            decoding="async"
          />
        </figure>
      ))
    }
    <div class="hero__scrim" aria-hidden="true"></div>
  </div>

  <div class="hero__content shell">
    <p class="hero__eyebrow meta">{SITE.role}</p>
    <h1 class="hero__name display">Ido Yavin</h1>
    <p class="hero__tagline">{SITE.tagline}</p>
  </div>

  <a class="hero__scroll" href="#work">
    <span class="meta">Scroll</span>
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    /* svh keeps the hero from being clipped by mobile browser chrome */
    height: 100svh;
    min-height: 34rem;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero__stage {
    position: absolute;
    inset: 0;
    /* Never let the near-white page show through behind the slides. */
    background: var(--fg);
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    margin: 0;
    /* GSAP owns opacity from here. A CSS transition on the same property
       let both slides be mid-fade at once, dropping combined coverage
       below 1 so the page showed through and the hero read as black. */
    opacity: 0;
  }

  .hero__slide.is-active {
    opacity: 1;
  }

  .hero__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Nearly all frames are portrait, so a full-bleed landscape band shows
       only a thin horizontal slice. Biasing upward (38%) landed that slice in
       the sky — several slides rendered as an almost blank gradient. 55% puts
       the subject in frame: the ridges, the peak, the monastery. */
    object-position: 50% 55%;
  }

  .hero__slide.is-active img {
    animation: drift 14s var(--ease-out) forwards;
  }

  @keyframes drift {
    from {
      transform: scale(1.02);
    }
    to {
      transform: scale(1.09);
    }
  }

  /* Guarantees contrast for the overlaid type on any photograph.
     Weighted so the small eyebrow and tagline sit in genuinely dark
     territory — a hazy bright sky would otherwise drop the text to
     around 3:1. The mid-frame stays nearly clear so the photo reads. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    /* Above the slides (which raise to z-index 1 while fading), below the
       type. Two narrow bands rather than one full-height wash: the old
       gradient was built for the original dark theme and, kept after the
       switch to the light one, it buried the photograph almost entirely. */
    z-index: 2;
    background:
      linear-gradient(
        to top,
        rgba(10, 10, 11, 0.82) 0%,
        rgba(10, 10, 11, 0.5) 20%,
        rgba(10, 10, 11, 0) 46%
      ),
      linear-gradient(
        to bottom,
        rgba(10, 10, 11, 0.5) 0%,
        rgba(10, 10, 11, 0) 20%
      );
  }

  .hero__content {
    position: relative;
    z-index: 3;
    width: 100%;
    padding-bottom: clamp(5rem, 12vh, 9rem);
  }

  /* Everything in the hero sits on a photograph, so it uses the
     on-photo ink rather than the page's dark text colour. */
  .hero__content {
    color: var(--on-photo);
    --meta-ink: var(--on-photo);
  }

  .hero__eyebrow {
    margin-bottom: var(--space-xs);
  }

  .hero__name {
    font-size: var(--step-5);
    line-height: 0.9;
    letter-spacing: -0.045em;
  }

  .hero__tagline {
    max-width: 30ch;
    margin-top: var(--space-xs);
    color: var(--on-photo-dim);
    font-size: var(--step-1);
  }

  .hero__scroll {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: var(--space-sm);
    transform: translateX(-50%);
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    padding: 0.5rem 1rem;
    color: var(--on-photo-dim);
    --meta-ink: var(--on-photo-dim);
    cursor: pointer;
  }

  .hero__scroll-line {
    width: 1px;
    height: 3rem;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.6), transparent);
  }

  .hero__scroll:hover .hero__scroll-line {
    animation: pulse 1.4s ease-in-out infinite;
  }

  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }

  /* The scroll cue overlaps the name on short screens */
  @media (max-height: 34rem) {
    .hero__scroll {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide.is-active img,
    .hero__scroll:hover .hero__scroll-line {
      animation: none;
    }
  }
</style>

<script>
  import { gsap } from '../scripts/motion';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const slides = hero
    ? Array.from(hero.querySelectorAll<HTMLElement>('[data-slide]'))
    : [];

  if (slides.length > 1) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let index = 0;
    let timer: number | undefined;

    // Explicit starting state so nothing depends on class timing.
    gsap.set(slides, { opacity: 0, zIndex: 0 });
    gsap.set(slides[0], { opacity: 1, zIndex: 1 });

    const hydrate = () => {
      hero?.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((img) => {
        img.srcset = img.dataset.srcset ?? '';
        img.src = img.dataset.src ?? '';
        delete img.dataset.src;
        delete img.dataset.srcset;
      });
    };

    if (document.readyState === 'complete') hydrate();
    else window.addEventListener('load', hydrate, { once: true });

    const show = (next: number) => {
      const prev = slides[index];
      index = next;
      const cur = slides[index];

      // The incoming slide fades in ON TOP; the outgoing one holds at full
      // opacity underneath until that finishes, so the two together always
      // cover the hero completely and the page never shows through.
      gsap.set(cur, { zIndex: 2 });
      gsap.to(cur, {
        opacity: 1,
        duration: 1.6,
        ease: 'power1.inOut',
        onComplete: () => {
          gsap.set(prev, { opacity: 0, zIndex: 0 });
          gsap.set(cur, { zIndex: 1 });
        },
      });
    };

    const start = () => {
      stop();
      timer = window.setInterval(() => show((index + 1) % slides.length), 6500);
    };

    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    };

    const sync = () => (reduced.matches ? stop() : start());

    sync();
    reduced.addEventListener('change', sync);

    document.addEventListener('visibilitychange', () => {
      document.hidden ? stop() : sync();
    });
  }
</script>
