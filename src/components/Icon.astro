---
/**
 * Line icons, drawn to a shared 24x24 grid with a 1.6 stroke so they sit
 * together evenly. Inline SVG rather than an icon font or emoji: it
 * inherits currentColor, scales cleanly, and costs no extra request.
 *
 * Always decorative here — every icon-only control that uses these must
 * carry its own visually-hidden label for its accessible name.
 */
interface Props {
  name: 'mail' | 'instagram' | 'tiktok' | 'message';
}

const { name } = Astro.props;
---

<svg
  class="icon"
  width="22"
  height="22"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'mail' && (
      <>
        <rect x="2" y="4.5" width="20" height="15" rx="2.5" />
        <path d="m2.8 6.3 8.2 5.4a1.9 1.9 0 0 0 2 0l8.2-5.4" />
      </>
    )
  }
  {
    name === 'instagram' && (
      <>
        <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
        <circle cx="12" cy="12" r="4.2" />
        <circle cx="17.4" cy="6.6" r="0.9" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'tiktok' && (
      <>
        <path d="M14.2 3v11.6a3.9 3.9 0 1 1-3.9-3.9c.36 0 .7.05 1.03.15" />
        <path d="M14.2 3c.45 2.6 2.5 4.5 5.1 4.7" />
      </>
    )
  }
  {
    name === 'message' && (
      <>
        <path d="M20.5 14.5a2 2 0 0 1-2 2H7.8L3.5 20.5V5a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2z" />
      </>
    )
  }
</svg>

<style>
  .icon {
    display: block;
    flex: none;
  }
</style>
